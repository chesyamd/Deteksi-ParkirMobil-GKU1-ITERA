# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# Sistem operasi / editor
.DS_Store
.vscode/
.idea/

# Citra & hasil: tidak di-commit (dibagikan lewat Drive), struktur folder tetap ada.
data/raw/*
data/background/*
data/source/*
data/outputs/*
!data/raw/.gitkeep
!data/background/.gitkeep
!data/source/.gitkeep
!data/outputs/.gitkeep

# Multi-scene (paket I-07): citra tiap scene tidak di-commit, anotasi (roi.json,
# ground_truth.csv) tetap masuk repo.
data/scenes/*/raw/*
data/scenes/*/background/*
!data/scenes/*/raw/.gitkeep
!data/scenes/*/background/.gitkeep

# Data sintetis (dibangkitkan ulang kapan saja)
sandbox/
